  "construct_definition": "Define, design, evaluate, interpret, report, and improve measurement and research systems with evidence for validity, precision, fairness, accessibility, uncertainty, and consequences. This is a project composite, not a universal PhD standard.",
  "claims": [
    {
      "layer": "SOURCE",
      "statement": "Testing standards emphasize validity, reliability or precision, fairness, accessibility, responsible interpretation, and consequences.",
      "source_ids": [
        "F2-67-009"
      ]
    },
    {
      "layer": "SOURCE",
      "statement": "Research and reporting standards require transparent conduct and reporting.",
      "source_ids": [
        "F2-67-008",
        "F2-67-011"
      ]
    },
    {
      "layer": "UNIVERSITY_EXEMPLAR",
      "statement": "UMD provides one concrete doctoral pathway through measurement, quantitative methodology, comprehensive examination, specialization, and dissertation.",
      "source_ids": [
        "F2-67-012"
      ]
    },
    {
      "layer": "INFERENCE",
      "statement": "The project can use these as a composite competency architecture while preserving source layers.",
      "source_ids": [
        "F2-67-008",
        "F2-67-009",
        "F2-67-011",
        "F2-67-012"
      ]
    }
  ],
