      "id": "Q1",
      "name": "construct clarity"
    },
    {
      "id": "Q2",
      "name": "evidence sufficiency"
    },
    {
      "id": "Q3",
      "name": "technical quality"
    },
    {
      "id": "Q4",
      "name": "uncertainty and interpretation"
    },
    {
      "id": "Q5",
      "name": "fairness, accessibility, and consequences"
    },
    {
      "id": "Q6",
      "name": "reporting and improvement"
    }
  ],
  "scoring_rules": [
    {
      "layer": "SOURCE",
      "rule": "Use exact standards clauses and source-specific evidence requirements."
    },
    {
      "layer": "EVALUATOR_DESIGN",
      "rule": "Never infer validity or fairness from one statistic or score."
    }
  ],
  "performance_levels": [
    {
      "level": "emerging",
      "description": "names methods or metrics but leaves construct, use, or uncertainty unclear"
    },
    {
      "level": "proficient",
      "description": "aligns construct, evidence, quality, interpretation, and consequences"
    },
    {
      "level": "transfer",
      "description": "audits a new evaluator and revises it with explicit residual risk"
    }
  ],
  "failure_modes": [
    {
      "id": "FM1",
      "name": "score-as-construct"
    },
    {
      "id": "FM2",
      "name": "precision-as-validity"
    },
    {
      "id": "FM3",
      "name": "fairness reduced to one statistic"
    },
    {
      "id": "FM4",
      "name": "university exemplar misrepresented as consensus"
    }
  ],
  "constraints": [
    {
      "id": "C1",
      "constraint": "label composite and university-specific layers"
    },
    {
      "id": "C2",
      "constraint": "expert review for consequential measurement use"
    },
    {
      "id": "C3",
      "constraint": "rights review for standards text"
    }
  ],
  "risk_considerations": [
    {
      "risk": "consequential decision harm",
      "control": "explicit interpretation and consequence review"
    },
    {
      "risk": "construct underrepresentation",
      "control": "construct map and boundary claims"
    },
    {
      "risk": "subgroup harm",
      "control": "fairness and accessibility evidence"
    }
  ],
  "agent_instructions": {
    "allowed_role": "calculate, compare, annotate, and propose evidence maps",
    "must_do": [
      "define intended use",
      "show claim-to-evidence links",
      "surface uncertainty",
      "flag missing validity evidence"
    ],
    "must_not_do": [
      "declare validity",
      "make high-stakes decision",
      "collapse source and synthesis"
    ],
    "human_accountability": "measurement expert owns construct and decision interpretation"
  },
  "evaluator_checks": [
    {
      "id": "EV1",
      "check": "construct and decision are defined"
    },
    {
      "id": "EV2",
      "check": "claims map to evidence"
    },
    {
      "id": "EV3",
      "check": "precision, validity, fairness, and uncertainty are separated"
    },
    {
      "id": "EV4",
      "check": "consequence and improvement review is present"
    }
  ],
  "test_cases": [
    {
      "id": "TC1",
      "fixture": "high reliability, weak construct",
      "expected": "validity concern"
    },
    {
      "id": "TC2",
      "fixture": "subgroup disparity with missing context",
      "expected": "needs subgroup and consequence review"
    },
    {
      "id": "TC3",
      "fixture": "university syllabus",
      "expected": "university-specific label"
    },
    {
      "id": "TC4",
      "fixture": "agent evaluator",
      "expected": "construct drift and residual-risk audit"
    }
  ],
